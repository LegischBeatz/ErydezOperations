# Browser-facing port on the trusted Docker host.
ERYDEZ_PORT=8082

# MongoDB is internal to Compose, but authentication is required. Generate a
# URL-safe password with: openssl rand -hex 32
MONGO_ROOT_USERNAME=erydez
MONGO_ROOT_PASSWORD=
DB_NAME=erydez_operations

# Single-local-operator label used only for safe Integration Control Center audit text.
# This is not authentication, a credential, or a user account.
ERYDEZ_LOCAL_OPERATOR_LABEL=Local operator

# Retention for local operational evidence. Values must be positive integers.
# Health/audit content excludes provider payloads, credentials, and Gmail message bodies.
INTEGRATION_HEALTH_RETENTION_DAYS=90
INTEGRATION_AUDIT_RETENTION_DAYS=365
# Completed Gmail send-operation keys are retained only to make retries safe.
GMAIL_SEND_OPERATION_RETENTION_HOURS=24

# Shopify is the authoritative commerce source. Keep real credentials only in .env.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Google OAuth 2.0 for the Gmail integration. Create a Web application OAuth
# client in Google Cloud and register the redirect URI exactly as shown below.
# For the local Compose deployment: http://localhost:8082/api/gmail/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8082/api/gmail/oauth/callback
# Generate once with: openssl rand -base64 32 | tr '+/' '-_'
# This key encrypts Gmail refresh tokens before MongoDB persistence. Never rotate
# it without migrating existing tokens.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional: needed only for AI answer drafts. Keep the key out of version control.
OPENAI_API_KEY=
OPENAI_API_BASE=
GMAIL_AI_MODEL=gpt-5-mini
